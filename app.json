{
  "expo": {
    "name": "Finance de Poche",
    "slug": "finance-de-poche",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "financedepoche",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.merliche.finance",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.merliche.finance",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#04424A",
        "monochromeImage": "./assets/images/adaptive-icon-mono.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#04424A",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#04424A"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8c55c79-2d1b-4d36-a42f-bb328d1ba0af"
      }
    },
    "owner": "merliche"
  }
}
