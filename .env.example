# Copiez ce fichier en `.env` (non versionné) et renseignez vos propres valeurs.
# Dashboard Supabase : Project Settings > API — champs "Project URL" et clé "anon public".
# Ne jamais mettre la clé "service_role" ici : ce fichier finit inliné dans le bundle JS de l'app.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
